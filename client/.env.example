# EmailJS Configurations
# Get your credentials at: https://www.emailjs.com
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here
VITE_EMAILJS_AUTOREPLY_TEMPLATE_ID=your_emailjs_autoreply_template_id_here
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Backend Public API Base URL (Local dev default: http://localhost:5001)
# Production builds MUST configure a valid HTTPS origin (e.g. https://api.clearfiling.co.in)
VITE_API_BASE_URL=http://localhost:5001
