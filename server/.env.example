# ── Server Configuration ──────────────────────────────────────────
PORT=5001
NODE_ENV=development
# Reverse-proxy hop count (set to 1 in production behind Render/Railway/NGINX, 0 locally)
TRUST_PROXY=0

# ── MongoDB Connection (Local development or Client-Owned Atlas) ──
# Local dev: mongodb://127.0.0.1:27017/clearfiling_dev
# Production: mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/clearfiling_dev

# ── Authentication Security (JWT & Cookies) ───────────────────────
# Generate a strong 32+ character random secret for production (e.g., openssl rand -hex 48)
JWT_SECRET=replace_with_a_strong_random_secret_minimum_32_characters
JWT_EXPIRES_IN=8h
# Cookie SameSite policy: 'lax' for same-site subdomains (admin. + api.), 'none' only for cross-domain with HTTPS
COOKIE_SAMESITE=lax

# ── Allowed CORS Origins ──────────────────────────────────────────
# Comma-separated list of allowed origins (use ONLY HTTPS origins in production)
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174

# ── Initial Admin Seed CLI (Temporary CLI placeholders only) ───────
# Remove SEED_ADMIN_* from persistent production web runtime environment after seeding
SEED_ADMIN_NAME=ClearFiling Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace_before_seeding

# ── Document & Storage Configuration ──────────────────────────────
# Maximum uploaded file size in Megabytes (default: 10)
MAX_FILE_SIZE_MB=10

# Cloudinary Storage (Must belong to Client-Owned business account)
# Replace placeholders only in private environment configuration (never commit real secrets)
CLOUDINARY_CLOUD_NAME=pending_client_setup
CLOUDINARY_API_KEY=pending_client_setup
CLOUDINARY_API_SECRET=pending_client_setup
CLOUDINARY_DOCUMENTS_FOLDER=clearfiling/documents
